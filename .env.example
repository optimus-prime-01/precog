# Bright Data
BRIGHTDATA_API_KEY=your_bright_data_api_key_here

# AI Provider: "gemini" or "anthropic"
AI_PROVIDER=gemini

# Google Gemini (free — get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude API) — optional, add if available
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=precog_password

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_ENV=development
SCRAPER_INTERVAL_MINUTES=15
PREDICTION_CONFIDENCE_THRESHOLD=0.6
